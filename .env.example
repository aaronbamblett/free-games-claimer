# free-games-claimer (hardened fork) — environment configuration
# Copy this file to `.env` in the deployment dir (/mnt/pool/appdata/free-games-claimer/.env)
# and fill in real values. NEVER commit the real .env — it is gitignored (*.env).

# --- Telegram notifications (apprise tgram URL) ---------------------------------
# Format: tgram://<bot_token>/<chat_id>
# bot_token: from @BotFather. chat_id: your numeric Telegram user/chat id (@userinfobot).
NOTIFY=tgram://123456789:AA...your-bot-token.../987654321

# --- Amazon Prime Gaming --------------------------------------------------------
# Fully automatable: Prime uses a TOTP authenticator key (not email codes).
PG_EMAIL=you@example.com
PG_PASSWORD=your-amazon-password
# PG_OTPKEY = the TOTP *secret* (base32 string) shown when you set up an Authenticator
# app on the Amazon account ("Can't scan the barcode?" reveals the key). NOT a 6-digit code.
PG_OTPKEY=ABCDEFGHIJKLMNOP

# --- GOG ------------------------------------------------------------------------
# GOG only does EMAIL 2FA (no TOTP). On a new device it emails a 4-digit code.
# This fork auto-reads that code from Gmail over IMAP (see GMAIL_* below).
GOG_EMAIL=you@gmail.com
GOG_PASSWORD=your-gog-password

# --- Epic ------------------------------------------------------------------------
# Epic logs in via Google and must be done ONCE manually in the browser (noVNC on
# :6080) on first run. After that the saved session persists. No env vars needed;
# if you hit a captcha at checkout, solve it once via noVNC.

# --- Gmail IMAP (for GOG's email 2FA auto-read) ---------------------------------
# GMAIL_USER: the inbox GOG emails the code to.
# GMAIL_APP_PASSWORD: a Google *App Password* (NOT your account password).
#   Google Account -> Security -> 2-Step Verification -> App passwords -> create one.
#   16 chars; spaces are ignored. Requires 2-Step Verification enabled on the account.
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
